{
  "name": "johannschopplich/kirby-plausible",
  "description": "Plausible Analytics for Kirby CMS",
  "type": "kirby-plugin",
  "version": "1.0.3",
  "keywords": [
    "kirby",
    "kirby-cms",
    "kirby-plugin",
    "plausible",
    "analytics"
  ],
  "license": "MIT",
  "homepage": "https://github.com/johannschopplich/kirby-plausible#readme",
  "authors": [
    {
      "name": "Johann Schopplich",
      "email": "hello@johannschopplich.com",
      "homepage": "https://johannschopplich.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "getkirby/composer-installer": "^1"
  },
  "require-dev": {
    "getkirby/cms": "^5"
  },
  "scripts": {
    "csfix": "@php tools/phpcs/vendor/bin/php-cs-fixer fix",
    "dist": "composer install --no-dev"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "extra": {
    "kirby-cms-path": false,
    "kirby": {
      "compatible": "^4.0 || ^5.0"
    }
  }
}
